# Copy this file to client/.env.local and fill in the two values from
# Supabase Dashboard > Project Settings > API Keys. Only the PUBLISHABLE key belongs here.
# Never put a secret key or service-role key in a VITE_ variable: it would be shipped to every visitor's browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Public URL of the separately hosted EstateHub AI service.
VITE_AI_SERVICE_URL=http://localhost:8000
