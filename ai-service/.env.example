# Copy to ai-service/.env (never commit the real file) and load it before starting the service.
# These values stay on the server. None of them belongs in the React app.

# mock = built-in offline stand-in (no API key, for development and tests). anthropic | openai = real providers.
AI_PROVIDER=mock
# Required for anthropic/openai. Your provider API key.
AI_API_KEY=
# Required for anthropic/openai. The model id from your provider's dashboard (not guessed here).
AI_MODEL=
# Optional: override the provider API base URL.
# AI_BASE_URL=

# Used only to check that a request to /v1/describe comes from a signed-in EstateHub user.
# Use the PUBLISHABLE key. Never a service-role or secret key.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Set to false only for local development with the mock provider and no Supabase.
AI_REQUIRE_AUTH=true

# Comma-separated list of the websites allowed to call this service from a browser.
ALLOWED_ORIGINS=http://localhost:5173
# Set to true only if the service runs behind a trusted proxy that sets X-Forwarded-For.
TRUST_PROXY=false

# Rate limits (in memory, per service instance)
RATE_DESCRIBE_PER_HOUR=20
RATE_SEARCH_PER_MINUTE=15
RATE_CONCIERGE_PER_MINUTE=10
# Hard cap on AI provider calls per UTC day, to bound cost
AI_DAILY_LIMIT=2000
